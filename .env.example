# CeloHT Governance environment template
# This file is intentionally committed without real secrets.

NODE_ENV=development
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Prefer the current server-side Supabase secret key. Keep the legacy service
# role key only while the deployment is migrated.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CELO_NETWORK=sepolia
CELO_RPC_URL=
CELO_CHAIN_ID=11142220
GOVERNANCE_CONTRACT_ADDRESS=
TREASURY_MULTISIG_ADDRESS=
USDM_TOKEN_ADDRESS=
GOVERNANCE_VERSION=1.0.0
DEFAULT_QUORUM_BPS=2000
DEFAULT_APPROVAL_THRESHOLD_BPS=5000
DEFAULT_VOTING_PERIOD_SECONDS=604800
DEFAULT_EXECUTION_DELAY_SECONDS=172800
SIGNATURE_DOMAIN_NAME=CeloHT-Governance
SIGNATURE_DOMAIN_VERSION=1
LOG_LEVEL=info
CORRELATION_ID_HEADER=x-correlation-id
EMERGENCY_ROLE_MAX_DURATION_SECONDS=86400
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
AUTH_SERVICE_URL=

# Governance timelock is persistent application state. CeloHTGovernance does
# not deploy a separate timelock contract; execution is performed by the
# approved external Treasury Safe after the service-side delay.

# Production requirement:
# - Do not set these values in committed files.
# - Use a secret manager or runtime injection for real credentials.
# - Missing production config must fail closed.
