# ==============================================================================
# CeloHT Governance — Environment Configuration Template
#
# NEVER put real secrets in this file. This file documents which variables
# are required; actual values live only in a secret manager or a local
# .env that is git-ignored.
#
# The application MUST validate all of these at startup (see
# src/infrastructure/config/env.ts) and FAIL CLOSED if a required
# production variable is missing. It must never silently fall back to a
# development default in a production environment.
# ==============================================================================

# --- Runtime ---
NODE_ENV=                          # development | test | staging | production

# --- Database (Supabase/PostgreSQL) ---
DATABASE_URL=                      # postgres connection string (no default in prod)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY is a secret: inject via secret manager only.
# Never place its real value here or in any committed file.

# --- Blockchain / Celo network configuration ---
CELO_NETWORK=                      # mainnet | alfajores | sepolia
CELO_RPC_URL=                      # must be an explicit, verified RPC endpoint
CELO_CHAIN_ID=                     # explicit chain id for replay protection

# --- Governance contract addresses ---
# These MUST come from verified deployment artifacts. If a contract has not
# been deployed and verified for the target network, leave blank and the
# application must fail closed rather than treat governance as active.
GOVERNANCE_CONTRACT_ADDRESS=
TIMELOCK_CONTRACT_ADDRESS=
TREASURY_MULTISIG_ADDRESS=

# --- Stablecoin / gas reference (NOT governance tokens) ---
USDM_TOKEN_ADDRESS=
# CELO is the native gas asset; no address needed.

# --- Governance parameters (defaults must be explicit, not implicit) ---
GOVERNANCE_VERSION=                # e.g. 1.0.0 — referenced by every proposal
DEFAULT_QUORUM_BPS=                # e.g. 2000 = 20.00%, expressed in basis points
DEFAULT_APPROVAL_THRESHOLD_BPS=    # e.g. 5000 = 50.00%
DEFAULT_VOTING_PERIOD_SECONDS=
DEFAULT_EXECUTION_DELAY_SECONDS=

# --- Auth / signing ---
SIGNATURE_DOMAIN_NAME=CeloHT-Governance
SIGNATURE_DOMAIN_VERSION=1
# No private keys, ever. Signing for execution is done by an external
# authorized executor/multisig, never by this service holding a key.

# --- Observability ---
LOG_LEVEL=                         # debug | info | warn | error
CORRELATION_ID_HEADER=x-correlation-id

# --- Emergency governance ---
EMERGENCY_ROLE_MAX_DURATION_SECONDS=   # hard cap enforced in code, not just docs
